:: default : notify "in default mode"
:: xspace @ : notify "in space mode"
default < ctrl + cmd + alt - x ; xspace
xspace < x ; default
# alt - 1 : yabai -m space --focus 1
# alt - 2 : yabai -m space --focus 2
# alt - 3 : yabai -m space --focus 3
# alt - 4 : yabai -m space --focus 4
# alt - 5 : yabai -m space --focus 5
# alt - 6 : yabai -m space --focus 6

default < alt - 1 : open /Applications/Obsidian.app
default < alt - 2 : open /Applications/Ghostty.app
default < alt - 3 : open /Applications/Arc.app

# default < alt - 4 : open /Applications/Notion.app
default < alt - 5 : open /Applications/slack.app
default < alt - 6 : open /Applications/Asana.app
default < alt - 7 : open /Applications/Figma.app

ctrl - 1 : yabai -m space --focus 1 
ctrl -2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5

alt - 0 : yabai -m space --layout \
$( [[ $( yabai -m query --spaces | jq '.[] | select(.["has-focus"]==true) | .type | test("bsp")') == "true"  ]] && echo "stack" || echo "bsp" )

alt - tab : yabai -m display --focus recent

ctrl + cmd - left : yabai -m space --rotate 90

# sends window to the right DISPLAY and then focuses it
shift + ctrl + cmd - right : yabai -m window --display east \
yabai -m window --focus 

# sends window to the left DISPLAY and then focuses it
shift + ctrl + cmd - left : yabai -m window --display west \
yabai -m window --focus


# sends window to # space 
ctrl + cmd + alt - 1 : yabai -m window --space 1 \
yabai -m window --focus

ctrl + cmd + alt - 2 : yabai -m window --space 2 \
yabai -m window --focus

ctrl + cmd + alt - 3 : yabai -m window --space 3 \
yabai -m window --focus

ctrl + cmd + alt - 4 : yabai -m window --space 4 \
yabai -m window --focus

ctrl + cmd + alt - 5 : yabai -m window --space 5 \
yabai -m window --focus

xspace < cmd - n : yabai -m space --create
xspace < cmd - d : yabai -m space --destroy


alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east



