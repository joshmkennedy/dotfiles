##
# THEME
##
# theme = Rose Pine Moon
theme = TokyoNight Moon

##
# FONT
##
font-family = JetBrains Mono Nerd Font
font-size = 15
adjust-cell-height = 3
bold-is-bright = true

##
# WINDOW
##
# title = "yo mom"
window-decoration = auto
macos-titlebar-style = hidden

keybind=global:ctrl+g=toggle_quick_terminal

title = "🌵"
shell-integration-features = no-cursor


##
# ICON
##
macos-icon=custom-style
#options are: blueprint, chalkboard, microchip, glass, holographic, paper, retro, xray, or custom-style
macos-icon-frame=aluminum
#aluminum ,beige ,plastic ,chrome
macos-icon-ghost-color=#CF0087
macos-icon-screen-color=#054096,#002B5B,#001F3F

##
# MISC
##
desktop-notifications=true

cursor-style=block

cursor-color=#EBBCBA

cursor-style-blink=false

keybind = ctrl+super+j=jump_to_prompt:1

background-opacity=0.95
background-blur=20

bell-features = system,audio
bell-features = audio,system
bell-audio-path = ~/.config/beep.mp3
